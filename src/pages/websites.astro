---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PriceCard from '../components/PriceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import DarkBand from '../components/DarkBand.astro';
import Accordion from '../components/Accordion.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import LaptopMock from '../components/LaptopMock.astro';
import PhoneMock from '../components/PhoneMock.astro';
import ExampleTile from '../components/ExampleTile.astro';
import { packages } from '../config/packages';
import { prices, formatRand as R, whatsappHref, deliveryLine } from '../config/business';

const x = prices.extras;
const wa = whatsappHref("Hi Straat Studio, I'd like a free homepage preview for my business.");
const faqs: [string, string][] = [
  ['Are the prices final?', 'Yes. The website prices are once-off and final, and no VAT is added. Each package includes a .co.za domain and first-year hosting, the words written for you and 2 rounds of changes.'],
  ['Can I edit the website myself?', `Catalogue websites only: you edit your own product names, descriptions and prices in your product sheet, and the site refreshes within minutes. We change everything else on the site (pages, text, photos and our package prices): send a WhatsApp and it is done within 48 hours. Straat Care includes one small change a month, and a single change without a plan is ${R(prices.singleChangeAfterLaunch)}.`],
  ['Do I get a business email address?', `An address like info@yourbusiness.co.za can forward to your Gmail at no charge. If you want a full mailbox to send and receive from, we can set one up for ${R(x.mailbox.price)}, and you pay the email provider directly each month.`],
  ['Do I see the website before I pay?', 'Yes. Every business gets a free homepage preview first. It is a view-only page, and changes start once you approve it and pay to start.'],
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Websites for small businesses',
    provider: { '@type': 'ProfessionalService', name: 'Straat Studio', url: 'https://straatstudio.co.za' },
    areaServed: { '@type': 'Country', name: 'South Africa' },
    description: 'Fixed-price websites for small businesses across South Africa, with a .co.za domain and first-year hosting included.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---

<BaseLayout
  title="Websites for small businesses | Straat Studio"
  description="Four fixed-price website packages for small businesses across South Africa, each with a .co.za domain and first-year hosting. Free preview first."
  path="/websites/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Websites', path: '/websites/' }]}
  jsonLd={jsonLd}
>
  <PageHero label="Websites" h1="Websites for small businesses" lead="Fixed prices, on the page. We write the words from a WhatsApp chat and build the site for you. Every price is once-off and final, with no VAT added. You see your homepage free before you pay.">
    <Fragment slot="actions">
      <Button href={wa} event="whatsapp-click">Get my free homepage</Button>
      <Button href="/prices/" variant="secondary">See every price</Button>
    </Fragment>
  </PageHero>

  <section class="section bg-grey" aria-labelledby="pk-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Packages</SectionLabel><h2 id="pk-h">The four website packages.</h2></div>
      <div class="grid g4">
        {packages.map((p) => <PriceCard name={p.pkg.name} price={R(p.pkg.price)} forWho={p.forWho} items={[p.pages, ...p.items.filter((i) => !i.startsWith('Up to') || i.includes('products'))]} when={`${deliveryLine(p.live)}.`} featured={'featured' in p} badge={'featured' in p ? 'Recommended for trades' : undefined} href={'soon' in p ? whatsappHref("Hi Straat Studio, I'd like to ask about the Catalogue website. I see it is coming soon.") : "/prices/"} cta={'soon' in p ? "Ask on WhatsApp" : "Compare on the prices page"} soon={'soon' in p} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="inc-h">
    <div class="wrap two">
      <div data-reveal><SectionLabel>In every package</SectionLabel><h2 id="inc-h">What you get with every website.</h2></div>
      <ul class="ticks" data-reveal>
        <li><Icon name="check" />A .co.za domain, registered in your name, and first-year hosting</li>
        <li><Icon name="check" />The words written for you, from a WhatsApp chat</li>
        <li><Icon name="check" />Call and WhatsApp buttons</li>
        <li><Icon name="check" />2 rounds of changes</li>
        <li><Icon name="check" />A free homepage preview before you pay</li>
      </ul>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="add-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Add-ons</SectionLabel><h2 id="add-h">Google, WhatsApp and the small things.</h2></div>
      <table class="tbl" data-reveal>
        <caption class="sr">Add-ons for your website</caption>
        <thead><tr><th scope="col">Add-on</th><th scope="col">What it is</th><th scope="col">Price</th></tr></thead>
        <tbody>
          <tr><th scope="row">Google Business Profile</th><td style="font-weight:400">Created or cleaned up, linked to your website, in your name. We are added as a manager and you can remove us any time. Included in Business, Catalogue and the Launch Pack.</td><td>{R(x.googleBusinessProfile.price)}</td></tr>
          <tr><th scope="row">WhatsApp Business setup</th><td style="font-weight:400">Greeting and away messages and quick replies, ready to paste. Included in Business, Catalogue and the Launch Pack.</td><td>Included</td></tr>
          <tr><th scope="row">Logo</th><td style="font-weight:400">A clean name logo with 3 options. In the Launch Pack.</td><td>{R(x.logo.price)}</td></tr>
          <tr><th scope="row">Poster pack</th><td style="font-weight:400">3 posters sized for Facebook and Instagram. In the Launch Pack.</td><td>{R(x.posters.price)}</td></tr>
          <tr><th scope="row">Mailbox setup</th><td style="font-weight:400">A full mailbox to send and receive from. You pay the email provider directly each month.</td><td>{R(x.mailbox.price)}</td></tr>
          <tr><th scope="row">Extra page</th><td style="font-weight:400">One more page on your website.</td><td>{R(x.extraPage.price)}</td></tr>
        </tbody>
      </table>
      <p style="margin-top:20px">Want an email alert when a customer asks for a quote? See <a class="more" href="/enquiry-system/">enquiry alerts</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="ask-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Before we start</SectionLabel><h2 id="ask-h">What we will ask you for.</h2></div>
      <div class="grid g3">
        <Card icon="list" title="Every package"><ul><li><Icon name="check" />Business name, logo if you have one</li><li><Icon name="check" />Services and prices</li><li><Icon name="check" />Areas you serve and your hours</li><li><Icon name="check" />Phone, WhatsApp and email</li><li><Icon name="check" />6 to 15 photos of your work</li></ul></Card>
        <Card icon="layers" title="Business and Launch Pack"><ul><li><Icon name="check" />A few lines on each service</li><li><Icon name="check" />Your Google Business Profile, or we create one</li><li><Icon name="check" />Before and after photos, if you have them</li><li><Icon name="check" />Logo and poster ideas (Launch Pack)</li></ul></Card>
        <Card icon="grid" title="Catalogue (coming soon)"><ul><li><Icon name="check" />Your first product list, which we load into your product Google Sheet</li><li><Icon name="check" />One photo per product</li><li><Icon name="check" />Delivery or collection areas and fees</li><li><Icon name="check" />Your PayFast or Yoco account, if you want payments</li></ul></Card>
      </div>
      <ul class="links">
        <li><a href="/websites-for-electricians/">Websites for electricians</a></li><li><a href="/websites-for-plumbers/">Plumbers</a></li><li><a href="/websites-for-salons/">Salons</a></li><li><a href="/websites-for-home-bakers/">Home bakers</a></li><li><a href="/examples/">See our examples</a></li>
      </ul>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="faq-h">
    <div class="wrap"><div class="head" data-reveal><SectionLabel>Questions</SectionLabel><h2 id="faq-h">Questions about our websites.</h2></div><Accordion items={faqs} /></div>
  </section>

  <DarkBand />
</BaseLayout>
