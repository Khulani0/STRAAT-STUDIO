---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PriceCard from '../components/PriceCard.astro';
import DarkBand from '../components/DarkBand.astro';
import Accordion from '../components/Accordion.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import { packages } from '../config/packages';
import { business, prices, formatRand as R, whatsappHref, deliveryLine, deliveryDays } from '../config/business';

const w = prices.websites;
const m = prices.monthly;
const x = prices.extras;
const pm = prices.payMonthly;
const wa = whatsappHref("Hi Straat Studio, I'd like help choosing a website package.");
const pageUrl = `${business.siteUrl}/prices/`;

const addOns = [
  [x.logo, 'A clean name logo, 3 options. Included in the Launch Pack.'],
  [x.posters, '3 posters sized for Facebook and Instagram. Included in the Launch Pack.'],
  [x.googleBusinessProfile, 'Create your profile or clean up the one you have, linked to your website. Already included in Business, Catalogue and the Launch Pack.'],
  [x.mailbox, 'A full mailbox to send and receive from. You pay the email provider directly each month.'],
  [x.extraPage, 'One more page on your website.'],
] as const;

const faqs = [
  ['Are the prices final?', 'Yes. The website prices are once-off and final, and no VAT is added. Each package includes a .co.za domain and first-year hosting, the words written for you and 2 rounds of changes.'],
  ['What does it cost after the first year?', `Without a plan, hosting and your domain cost ${R(prices.year2HostingAndDomain)} a year from year 2. With Straat Care at ${R(m.care.price)} a month, hosting and your domain are included from year 2.`],
  ['What if I want more changes?', `Extra changes during the build are ${R(prices.extraChangeDuringBuild)} each. After launch, a single change is ${R(prices.singleChangeAfterLaunch)} if you do not have Straat Care.`],
  ['Can I pay monthly?', `Yes. Business with Straat Leads is ${R(pm.setup)} to start, then ${R(pm.monthlyFor12Months)} a month for ${pm.months} months. The website is yours after the 12th payment, and Straat Leads then continues at ${R(pm.monthlyAfter)} a month.`],
  ['Can I edit the website myself?', `Catalogue websites only: you edit your own product names, descriptions and prices in your product sheet, and the site refreshes within minutes. We change everything else on the site (pages, text, photos and our package prices): send a WhatsApp and it is done within 48 hours. Straat Care includes one small change a month, and a single change without a plan is ${R(prices.singleChangeAfterLaunch)}.`],
  ['Do I see the website before I pay?', 'Yes. Every business gets a free homepage preview first. It is a view-only page, and changes start once you approve it and pay to start.'],
];

const jsonLd = [
  ...packages.map((p) => ({
    '@context': 'https://schema.org', '@type': 'Offer',
    name: `${p.pkg.name} website`, description: p.description,
    price: String(p.pkg.price), priceCurrency: 'ZAR', url: `${pageUrl}#${p.key}`,
    areaServed: { '@type': 'Country', name: 'South Africa' },
    seller: { '@type': 'ProfessionalService', name: business.name, url: business.siteUrl },
    itemOffered: { '@type': 'Service', name: `${p.pkg.name} website`, provider: { '@type': 'ProfessionalService', name: business.name, url: business.siteUrl } },
  })),
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<BaseLayout
  title="Website prices in South Africa | Straat Studio"
  description={`Fixed website prices from ${R(w.onePage.price)} to ${R(w.launchPack.price)}, domain and first-year hosting included. See every package, add-on and monthly plan.`}
  path="/prices/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Prices', path: '/prices/' }]}
  jsonLd={jsonLd}
  whatsappMessage="Hi Straat Studio, I'd like help choosing a website package."
>
  <PageHero label="Prices" h1="Prices" lead="Website and monthly plan prices, all in one place. Every price is once-off and final, with no VAT added. You see your homepage free before you pay.">
    <Fragment slot="actions">
      <Button href={wa} event="whatsapp-click">Help me choose a package</Button>
      <Button href="#builder" variant="secondary">Build your package</Button>
    </Fragment>
  </PageHero>

  <section class="section section-flush bg-grey" aria-labelledby="pk-h">
    <div class="wrap" style="padding-bottom:var(--section-y)">
      <div class="head" data-reveal><SectionLabel>Website packages</SectionLabel><h2 id="pk-h">Four packages. Pick the one that fits.</h2></div>
      <div class="grid g4">
        {packages.map((p) => (
          <PriceCard id={p.key} name={p.pkg.name} price={R(p.pkg.price)} forWho={p.forWho} items={p.items} when={`${deliveryLine(p.live)}. ${p.pay}.`} featured={'featured' in p} badge={'featured' in p ? 'Recommended for trades' : undefined} href={whatsappHref(`Hi Straat Studio, I'm interested in the ${p.pkg.name} website.`)} cta={`Start with ${p.pkg.name}`} />
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pay-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>How you pay</SectionLabel><h2 id="pay-h">Pay once, or pay monthly.</h2></div>
      <div class="grid g2">
        <Card icon="coin" title="Pay once" level="h3">
          <p>One-Page is paid in full to start. Business, Catalogue and Launch Pack are 50% to start and 50% before the website goes live. We are paid by EFT.</p>
          <ul><li><Icon name="check" />Prices are once-off and final, no VAT added</li><li><Icon name="check" />Domain and first-year hosting included</li></ul>
        </Card>
        <Card icon="calendar" title="Pay monthly" level="h3" id="pay-monthly">
          <p>The {pm.includes} package, spread over {pm.months} months.</p>
          <ul>
            <li><Icon name="check" /><span><strong>{R(pm.setup)}</strong> to start</span></li>
            <li><Icon name="check" /><span><strong>{R(pm.monthlyFor12Months)} a month</strong> for {pm.months} months, {R(pm.setup + pm.monthlyFor12Months * pm.months)} in total</span></li>
            <li><Icon name="check" /><span>The website is yours after the {pm.months}th payment, then Straat Leads continues at <strong>{R(pm.monthlyAfter)} a month</strong></span></li>
          </ul>
          <Button href={whatsappHref('Hi Straat Studio, tell me about the pay-monthly option.')} variant="secondary" event="whatsapp-click">Ask about pay-monthly</Button>
        </Card>
      </div>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="inc-h">
    <div class="wrap two">
      <div data-reveal>
        <SectionLabel>In every package</SectionLabel>
        <h2 id="inc-h">What is included in every package.</h2>
        <p class="lead" style="margin-top:14px">No hidden extras on the website itself.</p>
      </div>
      <ul class="ticks" data-reveal>
        <li><Icon name="check" />A .co.za domain, registered in your name, and first-year hosting</li>
        <li><Icon name="check" />The words written for you, from a WhatsApp chat</li>
        <li><Icon name="check" />Call and WhatsApp buttons</li>
        <li><Icon name="check" />2 rounds of changes</li>
        <li><Icon name="check" />A free homepage preview before you pay</li>
        <li><Icon name="check" />{deliveryLine(deliveryDays.business).replace('We aim to have it live', 'We aim to be live')}, depending on the package</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="add-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Add-ons</SectionLabel><h2 id="add-h">Extras, once-off and final.</h2><p class="lead">Add any of these to a website package. Each is a once-off price.</p></div>
      <table class="tbl" data-reveal>
        <caption class="sr">Add-ons and their once-off prices</caption>
        <thead><tr><th scope="col">Add-on</th><th scope="col">What it is</th><th scope="col">Price</th></tr></thead>
        <tbody>{addOns.map(([a, note]) => <tr><th scope="row">{a.name}</th><td style="font-weight:400">{note}</td><td>{R(a.price)}</td></tr>)}</tbody>
      </table>
      <p class="small muted" style="margin-top:16px">Extra changes during the build are {R(prices.extraChangeDuringBuild)} each. After launch, a single change is {R(prices.singleChangeAfterLaunch)} without Straat Care.</p>
    </div>
  </section>

  <section class="section bg-grey" id="monthly" aria-labelledby="mon-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Monthly plans</SectionLabel><h2 id="mon-h">Optional, and you can cancel any time.</h2><p class="lead">Your website stays yours either way.</p></div>
      <div class="grid g3">
        <Card title={m.care.name} icon="shield"><p class="amt-sm">{R(m.care.price)} <small>a month</small></p><p>Backups, uptime checks and 1 small change a month. From year 2, hosting and your domain are included.</p></Card>
        <Card title={m.leads.name} icon="bell"><p class="amt-sm">{R(m.leads.price)} <small>a month</small></p><p>Everything in Care, plus an email alert to you for each enquiry, an automatic reply to the customer and a monthly report.</p></Card>
        <Card title={m.growth.name} icon="chart"><p class="amt-sm">{R(m.growth.price)} <small>a month</small></p><p>Everything in Leads, plus 2 Google posts a month and a new service or area page every quarter.</p></Card>
      </div>
      <p class="small muted" style="margin-top:20px">Without a plan, hosting and your domain cost {R(prices.year2HostingAndDomain)} a year from year 2. With Straat Care at {R(m.care.price)} a month, they are included.</p>
    </div>
  </section>

  <section class="section" id="builder" aria-labelledby="bld-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Price builder</SectionLabel><h2 id="bld-h">Pick what you need. The total updates as you go.</h2></div>
      <div class="builder">
        <div class="builder-l">
          <fieldset style="margin-top:0"><legend>1. Your website</legend><div class="opts">
            {[w.onePage, w.business, w.catalogue, w.launchPack].map((p, i) => (
              <label class="opt"><input type="radio" name="b-site" value={p.price} data-name={p.name} checked={i === 1} /><span>{p.name} {R(p.price)}</span></label>
            ))}
          </div></fieldset>
          <fieldset><legend>2. Monthly plan (optional)</legend><div class="opts">
            <label class="opt"><input type="radio" name="b-plan" value="0" data-name="No plan" /><span>No plan</span></label>
            {[m.care, m.leads, m.growth].map((p, i) => (
              <label class="opt"><input type="radio" name="b-plan" value={p.price} data-name={p.name} checked={i === 1} /><span>{p.name.replace('Straat ', '')} {R(p.price)}</span></label>
            ))}
          </div></fieldset>
          <fieldset><legend>3. Extras</legend><div class="opts">
            {[x.logo, x.posters, x.googleBusinessProfile, x.mailbox, x.extraPage].map((p) => (
              <label class="opt"><input type="checkbox" name="b-extra" value={p.price} data-name={p.name} data-lock={p === x.googleBusinessProfile ? 'gbp' : (p === x.logo || p === x.posters ? 'launch' : '')} /><span>{p.name} {R(p.price)}</span></label>
            ))}
          </div></fieldset>
          <p class="small muted" id="b-note" style="margin-top:18px">The Launch Pack already includes the logo, posters and WhatsApp Business setup. Business, Catalogue and Launch Pack already include the Google Business Profile.</p>
        </div>
        <div class="builder-r" aria-live="polite">
          <p class="total-l">Once-off, final price</p>
          <p class="total" id="b-once">{R(w.business.price)}</p>
          <p class="total-l" style="margin-top:14px">Then</p>
          <p class="total-m" id="b-month">{R(m.leads.price)} a month</p>
          <Button id="b-send" href={wa} variant="whatsapp" icon="whatsapp">Send this to us on WhatsApp</Button>
          <p class="small" style="margin-top:10px">Domain and first-year hosting included. No VAT added. Free homepage preview before you pay.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="terms-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Plain terms</SectionLabel><h2 id="terms-h">The plain terms behind the prices.</h2><p class="lead">The short version. The full wording is on our <a class="more" href="/terms/">terms of service</a> page.</p></div>
      <div class="grid g2">
        <Card icon="key" title="You own what you pay for"><p>Your domain is registered in your name after you pay. The website and its files become yours when the final payment is made, with a handover guide. Your Google Business Profile stays in your name, and we are added as a manager you can remove at any time.</p></Card>
        <Card icon="refresh" title="Monthly plans are optional"><p>Monthly plans are optional. You can cancel at any time, and your website stays yours either way.</p></Card>
        <Card icon="coin" title="Deposit and refunds"><p>If you cancel before we start building, we refund your deposit in full. After we start, the deposit covers the work done so far. If we cannot deliver what we promised, we refund the part we did not deliver.</p></Card>
        <Card icon="search" title="No promises about Google"><p>We build every website so that Google can read it. We do not promise a position in Google results, and nobody honest can.</p></Card>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Questions</SectionLabel><h2 id="faq-h">About our prices.</h2></div>
      <Accordion items={faqs} />
    </div>
  </section>

  <DarkBand />
<script is:inline define:vars={{ waBase: `https://wa.me/${business.phoneDigits}?text=` }}>
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const rand = (n) => 'R' + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

    // Package builder
    const calc = () => {
      const site = $('input[name="b-site"]:checked');
      const plan = $('input[name="b-plan"]:checked');
      const isLaunch = site.dataset.name === 'Launch Pack';
      const extras = $$('input[name="b-extra"]');
      extras.forEach((e) => { const lock = (isLaunch && e.dataset.lock === 'launch') || (site.dataset.name !== 'One-Page' && e.dataset.lock === 'gbp'); e.disabled = lock; if (lock) e.checked = false; e.closest('.opt').style.opacity = lock ? .45 : 1; });
      const chosen = extras.filter((e) => e.checked);
      const once = Number(site.value) + chosen.reduce((s, e) => s + Number(e.value), 0);
      const monthly = Number(plan.value);
      $('#b-once').textContent = rand(once);
      $('#b-month').textContent = monthly ? `${rand(monthly)} a month` : 'Nothing monthly';
      const msg = `Hi Straat Studio, I'd like: ${site.dataset.name}${chosen.length ? ' + ' + chosen.map((e) => e.dataset.name).join(', ') : ''}${monthly ? ' + ' + plan.dataset.name : ''}. Total ${rand(once)} once-off${monthly ? ', then ' + rand(monthly) + ' a month' : ''}.`;
      $('#b-send').href = waBase + encodeURIComponent(msg);
    };
    $$('#builder input').forEach((i) => i.addEventListener('change', calc));
    calc();
  </script>
</BaseLayout>
