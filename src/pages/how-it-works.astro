---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PriceCard from '../components/PriceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import DarkBand from '../components/DarkBand.astro';
import Accordion from '../components/Accordion.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import LaptopMock from '../components/LaptopMock.astro';
import PhoneMock from '../components/PhoneMock.astro';
import ExampleTile from '../components/ExampleTile.astro';
import { prices, formatRand as R, whatsappHref, deliveryLine } from '../config/business';
const wa = whatsappHref("Hi Straat Studio, I'd like a free homepage preview for my business.");
const faqs: [string, string][] = [
  ['Can I ask for changes to the free preview?', `The preview shows our design for your business. Changes start once you approve it and pay: One-Page is paid in full, Business and Catalogue pay half. Every package then includes 2 rounds of changes, each sent as one list. Extra changes during the build are ${R(prices.extraChangeDuringBuild)} each.`],
  ['How long does it take?', 'We aim to have it live within 3 to 7 working days after we have all your content, depending on the package. The clock starts when we have received everything we asked for.'],
  ['Do we need to meet?', 'No. Everything happens on WhatsApp, email and one short online form, wherever you are in South Africa.'],
  ['Who looks after backups and updates?', `Backups and small changes come with Straat Care from ${R(prices.monthly.care.price)} a month. Without a plan, the site is yours to run and a single change after launch is ${R(prices.singleChangeAfterLaunch)}.`],
];
---

<BaseLayout
  title="How it works | Straat Studio"
  description="See your homepage free, approve it, pay to start, then two rounds of changes before your website goes live on your own .co.za."
  path="/how-it-works/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'How it works', path: '/how-it-works/' }]}
>
  <PageHero label="How it works" h1="How it works" lead="See it first, pay after. Five stages, done on WhatsApp and one short online form. No meetings, wherever you are in South Africa.">
    <Fragment slot="actions">
      <Button href={wa} event="whatsapp-click">Get my free homepage</Button>
      <Button href="/prices/" variant="secondary">See prices from {R(prices.websites.onePage.price)}</Button>
    </Fragment>
  </PageHero>

  <section class="section bg-grey" aria-labelledby="st-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>The five stages</SectionLabel><h2 id="st-h">From first message to after launch.</h2></div>
      <ol class="steps" style="max-width:820px">
        <ProcessStep n={1} icon="chat" title="Tell us about your business" you="a reply on WhatsApp, not a form to fill in">Your business name, what you do and where. Two minutes on WhatsApp.</ProcessStep>
        <ProcessStep n={2} icon="eye" title="See your homepage free" you="a view-only preview link, designed and written for you">No payment yet. You decide whether to carry on.</ProcessStep>
        <ProcessStep n={3} icon="coin" title="Approve and pay to start" you="one checklist form for your package, and a clear invoice">One-Page is paid in full. Business, Catalogue and Launch Pack pay half to start and half before going live.</ProcessStep>
        <ProcessStep n={4} icon="refresh" title="Two rounds of changes, then live" you="your site on your own .co.za, with a sheet showing what you own">{deliveryLine(5)}. Send each round of changes as one list.</ProcessStep>
        <ProcessStep n={5} icon="shield" title="After launch" you="a website that is yours, with a plan if you want one">Your domain is registered in your name, and the website and its files become yours when the final payment is made. Straat Care includes one small change a month.</ProcessStep>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="after-h">
    <div class="wrap two">
      <div data-reveal><SectionLabel>After your website is live</SectionLabel><h2 id="after-h">Who changes what.</h2></div>
      <div class="prose" data-reveal>
        <p>Catalogue clients edit their own product names, descriptions and prices in the product sheet, and the site refreshes within minutes. We change everything else on the site (pages, text, photos and our package prices): send a WhatsApp and it is done within 48 hours.</p>
        <p>Straat Care includes one small change a month, and a single change without a plan is {R(prices.singleChangeAfterLaunch)}.</p>
        <ul class="links"><li><a href="/websites/">What we will ask you for</a></li><li><a href="/terms/">Terms of service</a></li></ul>
      </div>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="faq-h">
    <div class="wrap"><div class="head" data-reveal><SectionLabel>Questions</SectionLabel><h2 id="faq-h">Questions about how it works.</h2></div><Accordion items={faqs} /></div>
  </section>

  <DarkBand />
</BaseLayout>
