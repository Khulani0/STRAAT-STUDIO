---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PriceCard from '../components/PriceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import DarkBand from '../components/DarkBand.astro';
import Accordion from '../components/Accordion.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import LaptopMock from '../components/LaptopMock.astro';
import PhoneMock from '../components/PhoneMock.astro';
import ExampleTile from '../components/ExampleTile.astro';
import { examples } from '../config/packages';
import { prices, whatsappHref } from '../config/business';
const w = prices.websites;
const wa = whatsappHref("Hi Straat Studio, I'd like a free homepage preview for my business.");
---

<BaseLayout
  title="Examples of our work | Straat Studio"
  description="Three concept websites for made-up South African businesses, built to show our standard. Concept projects, not commissioned client work."
  path="/examples/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Examples', path: '/examples/' }]}
>
  <PageHero label="Examples" h1="Examples of our work" lead="Each business is different, so each site looks different. These are concept projects for made-up South African businesses, built to show the standard. Real client sites replace them here as they go live.">
    <Fragment slot="actions">
      <Button href={wa} event="whatsapp-click">Get my free homepage</Button>
      <Button href="/websites/" variant="secondary">See our websites</Button>
    </Fragment>
  </PageHero>

  <section class="section bg-grey" aria-labelledby="ex-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Concept projects</SectionLabel><h2 id="ex-h">Three concept projects.</h2></div>
      <div class="grid g3">
        {examples.map((e) => <ExampleTile slug={e.slug} img={e.img} name={e.name} line={e.line} pkgName={w[e.pkgKey].name} price={w[e.pkgKey].price} desktopAlt={e.desktopAlt} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="read-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>How to read these</SectionLabel><h2 id="read-h">What these examples are, and are not.</h2></div>
      <div class="grid g3">
        <Card icon="eye" title="Made-up businesses"><p>The names, suburbs, products and prices in these examples are made up. They are not commissioned client work.</p></Card>
        <Card icon="browser" title="Built to the same standard"><p>Each one is built the way we build a client site, in the package named on its tile.</p></Card>
        <Card icon="chat" title="Yours comes first as a preview"><p>You see your own homepage free before you pay, designed and written for your business.</p></Card>
      </div>
    </div>
  </section>

  <DarkBand />
</BaseLayout>
