---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PriceCard from '../components/PriceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import DarkBand from '../components/DarkBand.astro';
import Accordion from '../components/Accordion.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import LaptopMock from '../components/LaptopMock.astro';
import PhoneMock from '../components/PhoneMock.astro';
import ExampleTile from '../components/ExampleTile.astro';
import { business, whatsappHref, defaultWhatsappMessage, phoneHref, emailHref } from '../config/business';
const wa = whatsappHref(defaultWhatsappMessage);
const h = business.hours;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Straat Studio', url: `${business.siteUrl}/contact/`,
  mainEntity: {
    '@type': 'ProfessionalService', name: business.name, legalName: business.legalName, url: business.siteUrl,
    telephone: `+${business.phoneDigits}`, email: business.email, areaServed: { '@type': 'Country', name: 'South Africa' },
    openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: h.openDays, opens: h.opens, closes: h.closes }],
    contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer service', telephone: `+${business.phoneDigits}`, email: business.email, areaServed: 'ZA', availableLanguage: 'English' }],
  },
}];
---

<BaseLayout
  title="Contact Straat Studio | WhatsApp, phone, email"
  description="Message Straat Studio on WhatsApp, call or email. Open Monday to Saturday, 08:00 to 18:00. We work with businesses all over South Africa."
  path="/contact/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
  jsonLd={jsonLd}
>
  <PageHero label="Contact" h1="Contact Straat Studio" lead="Talk to us on WhatsApp. We are based in Cape Town and work with businesses all over South Africa. Everything happens on WhatsApp, by phone and by email, so you never need to visit us.">
    <Fragment slot="actions">
      <Button href={wa} variant="whatsapp" event="whatsapp-click" icon="whatsapp">Get my free preview on WhatsApp</Button>
      <Button href={phoneHref} variant="secondary" event="phone-click" icon="phone">Call {business.phoneDisplay}</Button>
    </Fragment>
  </PageHero>

  <section class="section bg-grey" aria-labelledby="ways-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Ways to reach us</SectionLabel><h2 id="ways-h">WhatsApp, phone or email.</h2></div>
      <div class="grid g3">
        <Card icon="whatsapp" title="WhatsApp"><p>Tap the link and your message opens ready to send.</p><p><a class="more" href={wa} rel="noopener" data-event="whatsapp-click">Message {business.phoneDisplay}</a></p></Card>
        <Card icon="phone" title="Phone"><p>Call us in business hours.</p><p><a class="more" href={phoneHref} data-event="phone-click">{business.phoneDisplay}</a></p></Card>
        <Card icon="mail" title="Email"><p>For longer questions, or if you prefer email.</p><p><a class="more" href={emailHref} data-event="email-click">{business.email}</a></p></Card>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="hrs-h">
    <div class="wrap two">
      <div data-reveal>
        <SectionLabel>Business hours</SectionLabel>
        <h2 id="hrs-h">When we answer.</h2>
        <table class="hours" style="margin-top:24px">
          <caption class="sr">Business hours, South African time</caption>
          <tbody>
            <tr><th scope="row">Monday to Saturday</th><td>{h.opens} to {h.closes}</td></tr>
            <tr><th scope="row">{h.closedDays.join(', ')}</th><td>Closed</td></tr>
          </tbody>
        </table>
      </div>
      <div data-reveal>
        <SectionLabel>Your first message</SectionLabel>
        <h2 style="font-size:var(--fs-h2)">What to send in your first message.</h2>
        <ul class="ticks" style="margin-top:24px"><li><Icon name="check" />Your business name</li><li><Icon name="check" />What you do</li><li><Icon name="check" />Where you work</li></ul>
        <p class="small muted" style="margin-top:16px">That is enough to start your free homepage preview. See our <a class="more" href="/prices/">prices</a> or read <a class="more" href="/about/">how we work</a>.</p>
      </div>
    </div>
  </section>

  <section class="section-tight bg-grey">
    <div class="wrap"><p class="small muted">{business.name} is a trading name of {business.legalName}, Reg. {business.regNumber}. How we handle your details is explained in our <a class="more" href="/privacy/">privacy notice</a>.</p></div>
  </section>

  <DarkBand />
</BaseLayout>
