---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Layout test | Straat Studio"
  description="Internal page for checking the shared Straat Studio design."
  path="/test-layout/"
  noindex
>
  <section class="sec">
    <div class="wrap">
      <h1>Shared layout test</h1>
      <p class="lead">This page checks that the shared header, footer, fonts and buttons match the homepage.</p>
      <p style="margin-top:28px"><a class="btn btn-blue" href="/">Back to the homepage</a></p>
    </div>
  </section>
</BaseLayout>
