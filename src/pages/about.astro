---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PriceCard from '../components/PriceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import DarkBand from '../components/DarkBand.astro';
import Accordion from '../components/Accordion.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import LaptopMock from '../components/LaptopMock.astro';
import PhoneMock from '../components/PhoneMock.astro';
import ExampleTile from '../components/ExampleTile.astro';
import { business, prices, formatRand as R, whatsappHref } from '../config/business';
const wa = whatsappHref("Hi Straat Studio, I read your About page and I'd like a free homepage preview.");
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Straat Studio', url: `${business.siteUrl}/about/`,
  mainEntity: { '@type': 'ProfessionalService', name: business.name, legalName: business.legalName, url: business.siteUrl, areaServed: { '@type': 'Country', name: 'South Africa' } },
}];
---

<BaseLayout
  title="About Straat Studio | Registered web studio"
  description="Straat Studio is a trading name of STRAATTECH (Pty) Ltd. Free preview first, fixed prices, you own your domain, and written terms."
  path="/about/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]}
  jsonLd={jsonLd}
  whatsappMessage="Hi Straat Studio, I read your About page and I'd like a free homepage preview."
>
  <PageHero label="About us" h1="About Straat Studio" lead={`A registered company with written terms. ${business.name} is a trading name of ${business.legalName}. We build websites and enquiry alerts for trades and small businesses across South Africa.`}>
    <Fragment slot="actions">
      <Button href={wa} event="whatsapp-click">Get my free homepage</Button>
      <Button href="/contact/" variant="secondary">Contact us</Button>
    </Fragment>
    <div slot="visual" class="facts" data-reveal>
      <div><span>Company</span><b>{business.legalName}</b></div>
      <div><span>Registration</span><b>{business.regNumber}</b></div>
      <div><span>Based in</span><b>Cape Town, Western Cape</b></div>
      <div><span>Where we work</span><b>All of South Africa, online</b></div>
      <div><span>Paperwork</span><b>Written agreement, POPIA data agreement</b></div>
    </div>
  </PageHero>

  <section class="section bg-grey" aria-labelledby="how-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>How we work</SectionLabel><h2 id="how-h">Four plain statements.</h2></div>
      <div class="grid g4">
        <Card icon="eye" title="Free preview first"><p>Every business gets one free homepage preview before paying anything. It is a view-only page, designed and written for you. Changes start once you approve it and pay to start.</p></Card>
        <Card icon="tag" title="Fixed prices"><p>Website prices start at {R(prices.websites.onePage.price)} and are once-off and final, with no VAT added. See every price on our <a class="more" href="/prices/">prices page</a>.</p></Card>
        <Card icon="key" title="You own your domain"><p>Your domain is registered in your name. The website and its files become yours when the final payment is made, with a handover guide. Your Google Business Profile stays in your name.</p></Card>
        <Card icon="quote" title="Terms in writing"><p>Prices, delivery times and what you own are written down before you pay. A one-page POPIA data agreement is signed before Straat Leads starts. Read our <a class="more" href="/terms/">terms</a> and <a class="more" href="/privacy/">privacy notice</a>.</p></Card>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="not-h">
    <div class="wrap two">
      <div data-reveal><SectionLabel>What we will not do</SectionLabel><h2 id="not-h">No tricks.</h2></div>
      <ul class="ticks" data-reveal>
        <li><Icon name="x" />We do not promise a position on Google. We build every site so Google can read it, and nobody can promise first place.</li>
        <li><Icon name="x" />We do not lock you in. If you leave, we hand over your files and logins.</li>
        <li><Icon name="x" />We do not show made-up clients or reviews. The sample sites on our examples page are labelled as concept projects, not commissioned client work.</li>
      </ul>
    </div>
  </section>

  <DarkBand heading="Start with a free preview." text="Send us your business name, what you do and where." waMessage="Hi Straat Studio, I read your About page and I'd like a free homepage preview." />
</BaseLayout>
