---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PriceCard from '../components/PriceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import DarkBand from '../components/DarkBand.astro';
import Accordion from '../components/Accordion.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Icon from '../components/Icon.astro';
import LaptopMock from '../components/LaptopMock.astro';
import PhoneMock from '../components/PhoneMock.astro';
import TradeMarquee from '../components/TradeMarquee.astro';
import ExampleTile from '../components/ExampleTile.astro';
import { packages, examples } from '../config/packages';
import { business, prices, formatRand as R, whatsappHref, deliveryLine } from '../config/business';

const w = prices.websites;
const m = prices.monthly;
const x = prices.extras;
const wa = whatsappHref("Hi Straat Studio, I'd like a free homepage preview for my business.");

const faqs = [
  ['Can I ask for changes to the free preview?', `The preview shows our design for your business. Changes start once you approve it and pay: One-Page is paid in full, Business and Catalogue pay half. Every package then includes 2 rounds of changes, each sent as one list. Extra changes during the build are ${R(prices.extraChangeDuringBuild)} each.`],
  ['Do you only work in Cape Town?', 'No. We are based in Cape Town and work with businesses all over South Africa. Everything happens on WhatsApp, email and online forms, so you never need to visit us.'],
  ['Will I come up on Google?', 'Every site is built with search in mind: one page per service, your towns and suburbs in the titles, and a Google Business Profile linked to it. Nobody can promise a ranking, and we do not.'],
  ['Who looks after backups and updates?', `Backups, uptime checks and small changes come with Straat Care from ${R(m.care.price)} a month. Without a plan, the site is yours to run and a single change after launch is ${R(prices.singleChangeAfterLaunch)}.`],
  ['Can I edit the website myself?', `Catalogue websites only: you edit your own product names, descriptions and prices in your product sheet, and the site refreshes within minutes. We change everything else on the site (pages, text, photos and our package prices): send a WhatsApp and it is done within 48 hours. Straat Care includes one small change a month, and a single change without a plan is ${R(prices.singleChangeAfterLaunch)}. Your site is made of plain files, so any developer can take it over.`],
  ['Do I get a business email address?', `An address like info@yourbusiness.co.za can forward to your Gmail at no charge. If you want a full mailbox to send and receive from, we can set one up for ${R(x.mailbox.price)}, and you pay the email provider directly each month.`],
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ProfessionalService',
    name: business.name, legalName: business.legalName, url: business.siteUrl,
    telephone: `+${business.phoneDigits}`, email: business.email,
    areaServed: { '@type': 'Country', name: 'South Africa' },
    priceRange: prices.priceRange, currenciesAccepted: 'ZAR',
    description: 'Websites, Google Business Profile setup and enquiry alerts for South African small businesses.',
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<BaseLayout
  title="Small business websites from R999 | Straat Studio"
  description="Websites for South African small businesses from R999, domain and hosting included, plus email alerts for quote requests. See a free preview."
  path="/"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" type="image/webp" href="/work/ndlovu-desktop-400.webp" imagesrcset="/work/ndlovu-desktop-400.webp 400w, /work/ndlovu-desktop-600.webp 600w, /work/ndlovu-desktop-800.webp 800w" imagesizes="(min-width: 960px) 470px, 90vw" />

  <PageHero
    label="Websites and enquiry alerts for South African businesses"
    h1="A website that helps customers find you and call you."
    lead="We build websites for small businesses across South Africa, and with Straat Leads you get an email alert when a customer sends a quote request. You see your homepage free, before you pay anything."
  >
    <Fragment slot="actions">
      <Button href={wa} event="whatsapp-click">Get my free homepage</Button>
      <Button href="/prices/" variant="secondary">See prices from {R(w.onePage.price)}</Button>
    </Fragment>
    <div slot="visual">
      <div class="hero-visual">
        <LaptopMock class="float" src="/work/ndlovu-desktop-400.webp" srcset="/work/ndlovu-desktop-400.webp 400w, /work/ndlovu-desktop-600.webp 600w, /work/ndlovu-desktop-800.webp 800w" sizes="(min-width: 960px) 470px, 90vw" alt={examples[2].desktopAlt} eager />
        <PhoneMock float />
      </div>
      <p class="concept-note" style="margin-top:14px;text-align:center">Concept project, not commissioned client work. The phone shows an example with made-up data.</p>
    </div>
  </PageHero>

  <section class="section bg-grey" aria-labelledby="do-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>What we do</SectionLabel>
        <h2 id="do-h">What we set up for a small business online.</h2>
        <p class="lead">One team, one WhatsApp line, one price on the page.</p>
      </div>
      <div class="grid g4">
        <Card icon="browser" title="Websites">
          <p>Fixed-price websites with call and WhatsApp buttons, a .co.za domain and first-year hosting. From {R(w.onePage.price)}.</p>
          <p><a class="more" href="/websites/">See the websites</a></p>
        </Card>
        <Card icon="pin" title="Google Business Profile">
          <p>Created or cleaned up and linked to your website, in your name. {R(x.googleBusinessProfile.price)}, or included in Business.</p>
          <p><a class="more" href="/websites/">What is included</a></p>
        </Card>
        <Card icon="bell" title="Enquiry alerts">
          <p>A quote form on your site and an email alert to you for each enquiry. {R(m.leads.price)} a month.</p>
          <p><a class="more" href="/enquiry-system/">See enquiry alerts</a></p>
        </Card>
        <Card icon="whatsapp" title="WhatsApp, logo and posters">
          <p>WhatsApp Business setup with ready-to-paste texts, a name logo and 3 posters for Facebook and Instagram.</p>
          <p><a class="more" href="/websites/">See the add-ons</a></p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="proc-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>How it works</SectionLabel>
        <h2 id="proc-h">See it first. Pay after.</h2>
        <p class="lead">Done on WhatsApp and one short online form. No meetings, wherever you are in South Africa.</p>
      </div>
      <ol class="steps" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))">
        <ProcessStep n={1} icon="chat" title="Tell us about your business" you="a reply on WhatsApp, not a form to fill in">Your business name, what you do and where. Two minutes on WhatsApp.</ProcessStep>
        <ProcessStep n={2} icon="eye" title="See your homepage free" you="a view-only preview link, designed and written for you">No payment yet. You decide whether to carry on.</ProcessStep>
        <ProcessStep n={3} icon="calendar" title="Approve, pay to start, go live" you="your site on your own .co.za after two rounds of changes">{deliveryLine(5)}.</ProcessStep>
      </ol>
      <p style="margin-top:28px"><a class="more" href="/how-it-works/">See all five stages</a></p>
    </div>
  </section>

  <section class="section section-flush bg-grey" aria-labelledby="trade-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>Who it is for</SectionLabel>
        <h2 id="trade-h">Built for trades and small businesses.</h2>
        <p class="lead">We have separate pages for <a class="more" href="/websites-for-electricians/">electricians</a>, <a class="more" href="/websites-for-plumbers/">plumbers</a>, <a class="more" href="/websites-for-salons/">salons</a> and <a class="more" href="/websites-for-home-bakers/">home bakers</a>.</p>
      </div>
    </div>
    <TradeMarquee />
  </section>

  <section class="section" id="prices" aria-labelledby="prices-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>Prices</SectionLabel>
        <h2 id="prices-h">Prices on the page, not after a meeting.</h2>
        <p class="lead">Once-off and final, with no VAT added. Every package includes a .co.za domain, first-year hosting, the words written for you and 2 rounds of changes.</p>
      </div>
      <div class="grid g4">
        {packages.map((p) => (
          <PriceCard name={p.pkg.name} price={R(p.pkg.price)} forWho={p.forWho} items={p.items.slice(0, 4)} when={`${deliveryLine(p.live)}.`} featured={'featured' in p} badge={'featured' in p ? 'Made for trades' : undefined} href={whatsappHref(`Hi Straat Studio, I'm interested in the ${p.pkg.name} website.`)} cta={`Start with ${p.pkg.name}`} />
        ))}
      </div>
      <div class="head" style="margin-top:56px;margin-bottom:24px" data-reveal>
        <h3 style="font-size:var(--fs-h2)">Optional monthly plans</h3>
        <p class="lead">Cancel any time. Your website stays yours either way.</p>
      </div>
      <div class="grid g3">
        <Card title={m.care.name} icon="shield"><p class="amt-sm">{R(m.care.price)} <small>a month</small></p><p>Backups, uptime checks and 1 small change a month. From year 2, hosting and your domain are included.</p></Card>
        <Card title={m.leads.name} icon="bell"><p class="amt-sm">{R(m.leads.price)} <small>a month</small></p><p>Everything in Care, plus an email alert to you for each enquiry, an automatic reply to the customer and a monthly report.</p></Card>
        <Card title={m.growth.name} icon="chart"><p class="amt-sm">{R(m.growth.price)} <small>a month</small></p><p>Everything in Leads, plus 2 Google posts a month and a new service or area page every quarter.</p></Card>
      </div>
      <div class="actions"><Button href="/prices/">See every price and build your package</Button></div>
    </div>
  </section>

  <section class="section bg-navy" aria-labelledby="leads-h">
    <div class="wrap two">
      <div data-reveal>
        <SectionLabel>Enquiry alerts</SectionLabel>
        <h2 id="leads-h">Get an email alert for each quote request.</h2>
        <p class="lead" style="margin-top:14px">Messages can get buried and quotes can be forgotten. A quote form and an email alert make each request easier to notice.</p>
        <ul class="ticks" style="margin-top:24px">
          <li><Icon name="check" />A quote form: job, suburb, phone, photos and an optional email</li>
          <li><Icon name="check" />An email alert to you for each enquiry</li>
          <li><Icon name="check" />An automatic reply to the customer</li>
          <li><Icon name="check" />A monthly report</li>
        </ul>
        <div class="actions"><Button href="/enquiry-system/">See how enquiry alerts work</Button></div>
      </div>
      <div style="max-width:300px;margin:0 auto;width:100%" data-reveal>
        <PhoneMock />
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>Examples</SectionLabel>
        <h2 id="work-h">Each business is different, so each site looks different.</h2>
        <p class="lead">Concept projects for made-up South African businesses, built to show the standard. Real client sites replace them as they go live.</p>
      </div>
      <div class="grid g3">
        {examples.map((e) => <ExampleTile slug={e.slug} img={e.img} name={e.name} line={e.line} pkgName={w[e.pkgKey].name} price={w[e.pkgKey].price} desktopAlt={e.desktopAlt} />)}
      </div>
      <p style="margin-top:28px"><a class="more" href="/examples/">See all the examples</a></p>
    </div>
  </section>

  <section class="section bg-grey" id="questions" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Questions</SectionLabel><h2 id="faq-h">Questions people ask</h2></div>
      <Accordion items={faqs} />
    </div>
  </section>

  <DarkBand heading="Send us your business name. Get your homepage back, free." text="No payment and no obligation. We aim to send your preview within 2 working days after you send us your business details." />
</BaseLayout>
