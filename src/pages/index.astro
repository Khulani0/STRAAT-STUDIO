---
/*
  Straat Studio homepage, design v3. Self-contained: own CSS and script.
  All prices come from src/config/business.ts.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  business,
  prices,
  formatRand as R,
  whatsappHref,
  phoneHref,
  emailHref,
} from '../config/business';

const w = prices.websites;
const m = prices.monthly;
const x = prices.extras;
const pm = prices.payMonthly;
const wa = whatsappHref("Hi Straat Studio, I'd like a free homepage preview for my business.");
const year = new Date().getFullYear();

// Real screenshots of the three finished concept sites (public/work/). Prices and package names come from business.ts.
const work = [
  {
    key: 'fazila',
    name: "Fazila's Kitchen",
    blurb: 'Home baker in Mitchells Plain. Sample menu with a category filter and an Order on WhatsApp button on every product.',
    pkg: w.catalogue,
    desktopAlt: "Home page of the Fazila's Kitchen concept site on a desktop screen: a concept-project bar, the headline Baked fresh, made for sharing, and a photo of a chocolate ring cake with white chocolate shavings.",
    phoneAlt: "Home page of the Fazila's Kitchen concept site on a phone: the concept-project bar, a menu button, the headline Baked fresh, made for sharing, and two buttons.",
  },
  {
    key: 'thandeka',
    name: 'Thandeka Hair Studio',
    blurb: 'Salon in Soweto. Sample prices, hours, areas and WhatsApp booking, all on one page.',
    pkg: w.onePage,
    desktopAlt: 'Home page of the Thandeka Hair Studio concept site on a desktop screen: a concept-project bar, the headline Braids, twists and natural hair, done with care, and a photo of copper-coloured twists seen from behind.',
    phoneAlt: 'Home page of the Thandeka Hair Studio concept site on a phone: the concept-project bar, a menu button, the headline Braids, twists and natural hair, done with care, and a Book on WhatsApp button.',
  },
  {
    key: 'ndlovu',
    name: 'Ndlovu Electrical',
    blurb: 'Five pages for an electrician in Athlone: services, areas served and a demo quote form.',
    pkg: w.business,
    desktopAlt: 'Home page of the Ndlovu Electrical concept site on a desktop screen: a concept-project bar, the headline Lights on. Breakers steady. Done right., and a photo of an open junction box full of wiring.',
    phoneAlt: 'Home page of the Ndlovu Electrical concept site on a phone: the concept-project bar, a menu button, the headline Lights on. Breakers steady. Done right., and a Chat on WhatsApp button.',
  },
];

const trades = [
  { name: 'Electricians', icon: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z' },
  { name: 'Plumbers', icon: 'M4 10h10a4 4 0 0 1 4 4v6M4 6v8M14 10V4h-4' },
  { name: 'Roofing and waterproofing', icon: 'M3 12 12 4l9 8M6 10v10h12V10' },
  { name: 'Solar installers', icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z' },
  { name: 'Painters and builders', icon: 'M4 4h12v5H4zM10 9v4M8 13h4v8H8z' },
  { name: 'Hair and nail salons', icon: 'M6 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM6 14a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM8.5 8.5 20 18M8.5 15.5 20 6' },
  { name: 'Home bakers and caterers', icon: 'M4 20h16M6 20v-7h12v7M8 13V9h8v4M12 9V5' },
  { name: 'Mechanics', icon: 'M14 6a4 4 0 0 0-5 5l-6 6 3 3 6-6a4 4 0 0 0 5-5l-2 2-2-2 2-2z' },
];

const faqs = [
  ['Can I ask for changes to the free preview?', `The preview shows our design for your business. Changes start once you approve it and pay: One-Page is paid in full, Business and Catalogue pay half. Every package then includes 2 rounds of changes, each sent as one list. Extra changes during the build are ${R(prices.extraChangeDuringBuild)} each.`],
  ['Do you only work in Cape Town?', 'No. We are based in Cape Town and work with businesses all over South Africa. Everything happens on WhatsApp, email and online forms, so you never need to visit us.'],
  ['Will I come up on Google?', 'Every site is built for search: one page per service, your towns and suburbs in the titles, fast loading and a Google Business Profile linked to it. No honest company can promise first place, and we never will.'],
  ['Who looks after backups and updates?', `Backups, uptime checks and small changes come with Straat Care from ${R(m.care.price)} a month. Without a plan, the site is yours to run and a single change after launch is ${R(prices.singleChangeAfterLaunch)}.`],
  ['Do I get a business email address?', `Yes. An address like info@yourbusiness.co.za forwards to your Gmail for free. A full mailbox can be set up for ${R(x.mailbox.price)}, and you pay the email provider directly.`],
];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ProfessionalService',
    name: business.name, legalName: business.legalName, url: business.siteUrl,
    telephone: `+${business.phoneDigits}`, email: business.email,
    areaServed: { '@type': 'Country', name: 'South Africa' },
    priceRange: prices.priceRange, currenciesAccepted: 'ZAR',
    description: 'Websites, Google Business Profile setup and enquiry tracking for South African small businesses.',
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<BaseLayout
  title="Small business websites from R999 | Straat Studio"
  description="Websites for South African small businesses from R999, domain and hosting included, plus an enquiry system that tracks every quote. See a free preview."
  path="/"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" type="image/webp" href="/work/ndlovu-desktop-600.webp" imagesrcset="/work/ndlovu-desktop-600.webp 600w, /work/ndlovu-desktop-800.webp 800w, /work/ndlovu-desktop-1200.webp 1200w" imagesizes="(min-width: 1024px) 480px, 92vw" fetchpriority="high" />

    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Websites and enquiry systems for South African businesses</p>
          <h1>Get found on Google. Catch <span class="mark">every enquiry.</span> Win more jobs.</h1>
          <p class="lead">We build fast websites for small businesses across South Africa, then keep track of every quote request so none slip through the cracks. You see your homepage free, before you pay anything.</p>
          <div class="hero-ctas">
            <a class="btn btn-blue" href={wa} rel="noopener" data-event="whatsapp-click">Get my free homepage</a>
            <a class="btn btn-ghost" href="#prices">See prices from {R(w.onePage.price)}</a>
          </div>
          <ul class="hero-trust">
            <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Final prices, no VAT</li>
            <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Domain in your name</li>
            <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Live in 3 to 7 working days</li>
          </ul>
        </div>

        <div class="stage">
          <div class="stage-disc" aria-hidden="true"></div>
          <div class="browser">
            <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img
              class="browser-shot"
              src="/work/ndlovu-desktop-600.webp"
              srcset="/work/ndlovu-desktop-600.webp 600w, /work/ndlovu-desktop-800.webp 800w, /work/ndlovu-desktop-1200.webp 1200w"
              sizes="(min-width: 1024px) 480px, 92vw"
              width="1200"
              height="750"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt={work[2].desktopAlt}
            />
          </div>
          <div class="phone" role="img" aria-label="The StraatOS enquiry system on a phone, with made-up data: a new enquiry alert for a DB board upgrade in Athlone, two earlier enquiries and a monthly summary.">
            <div class="phone-screen">
              <div class="phone-top">StraatOS<small>Ndlovu Electrical</small></div>
              <p class="phone-demo">Demo, made-up data</p>
              <div class="notif">
                <div class="notif-h"><i></i>New enquiry &middot; now</div>
                <b>DB board upgrade, Athlone</b>
                <span>"Lights trip when the geyser switches on." 2 photos</span><br />
                <span class="chip">New</span>
              </div>
              <div class="row-mini"><span><b>Geyser wiring</b><br />Rylands</span><span class="chip blue">Quote sent</span></div>
              <div class="row-mini"><span><b>COC certificate</b><br />Gatesville</span><span class="chip green">Won</span></div>
              <div class="row-mini"><span><b>Review request</b><br />Sent on WhatsApp</span><span class="chip green">Done</span></div>
              <div class="phone-sum"><b>14</b> enquiries this month<br /><b>5</b> won &middot; <b>3</b> waiting on a quote</div>
            </div>
          </div>
          <p class="stage-cap label-concept">Concept project, not commissioned client work. The phone shows the StraatOS demo with made-up data.</p>
        </div>
      </div>
    </section>

    <!-- TRADES -->
    <section class="trades" aria-labelledby="trades-h">
      <div class="wrap">
        <h2 id="trades-h" class="trades-title">Built for the small businesses that keep South Africa running</h2>
        <ul class="trade-grid" style="list-style:none;padding:0;margin:0">
          {trades.map((t) => (
            <li class="trade"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.icon} /></svg>{t.name}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- WHOLE PACKAGE -->
    <section class="sec night on-night" id="system" aria-labelledby="pkg-h">
      <div class="wrap pkg-grid">
        <div class="pkg-left">
          <p class="eyebrow">More than a website</p>
          <h2 id="pkg-h" style="color:#fff">A website is only the start. We look after what happens when someone finds you.</h2>
          <p class="lead">Most small businesses don't lose work because they are bad at the job. They lose it because a WhatsApp got buried, a quote was never followed up, or nobody asked for a review.</p>
          <div class="hero-ctas"><a class="btn btn-wa" href={wa} rel="noopener" data-event="whatsapp-click">Ask how it works</a></div>
        </div>
        <ol class="steps3" style="list-style:none;padding:0;margin:0">
          <li class="step3">
            <span class="num n1" aria-hidden="true">01</span>
            <div>
              <h3>Get found</h3>
              <p>A fast website with a page for every service and every area you work in, linked to a Google Business Profile in your name.</p>
              <span class="price-tag">Websites from {R(w.onePage.price)} once-off</span>
            </div>
          </li>
          <li class="step3">
            <span class="num n2" aria-hidden="true">02</span>
            <div>
              <h3>Catch every enquiry</h3>
              <p>Customers pick the job, the area and add photos. You get an instant alert, they get an instant reply, and every enquiry sits in one list with a status.</p>
              <span class="price-tag">Straat Leads {R(m.leads.price)} a month</span>
            </div>
          </li>
          <li class="step3">
            <span class="num n3" aria-hidden="true">03</span>
            <div>
              <h3>Win the job, then the next one</h3>
              <p>Reminders for quotes not yet accepted, and a Google review request after every finished job, so your reviews keep growing.</p>
              <span class="price-tag">Straat Growth {R(m.growth.price)} a month</span>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec" id="services" aria-labelledby="svc-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">What we do</p>
          <h2 id="svc-h">Everything a small business needs to look professional online.</h2>
          <p class="label-concept" style="margin-top:14px">The examples below use made-up businesses.</p>
        </div>

        <div class="svc">
          <div class="svc-art" style="--c:#f6e3ec" aria-hidden="true">
            <div class="ph2"><div class="ph2-s">
              <div class="th-hero"><strong>Thandeka Hair Studio</strong><span>Pimville, Soweto. Tue to Sat, 8am to 6pm</span></div>
              <div class="th-list"><div><span>Knotless braids</span><b>from R550</b></div><div><span>Cornrows</span><b>from R180</b></div><div><span>Wash and blow-dry</span><b>R150</b></div></div>
              <div class="th-book">Book on WhatsApp</div>
              <div class="th-map"><p><b>Find us:</b> 2 minutes' walk from the Pimville taxi rank. Walk-ins welcome before 10am.</p></div>
            </div></div>
          </div>
          <div>
            <p class="eyebrow">Websites</p>
            <h3>A website that works on a cheap phone with weak signal.</h3>
            <ul>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>We write the words for you, from a WhatsApp chat</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Call and WhatsApp buttons on every page</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>.co.za domain and first-year hosting included</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Online catalogue with WhatsApp ordering, from {R(w.catalogue.price)}</li>
            </ul>
            <div class="svc-price"><span class="muted">From</span><strong>{R(w.onePage.price)}</strong><span class="muted">once-off</span><a href="#prices">Compare packages</a></div>
          </div>
        </div>

        <div class="svc flip">
          <div class="svc-art" style="--c:var(--blue-soft)" aria-hidden="true">
            <div class="card-ui board">
              <div class="board-h">StraatOS enquiries <span>This month: 14</span></div>
              <div class="cols">
                <div class="col"><p>New</p><div class="tkt y">DB board upgrade<small>Athlone</small></div><div class="tkt y">Plugs, switches or lights<small>Rylands</small></div></div>
                <div class="col"><p>Contacted</p><div class="tkt">Fault finding<small>Athlone</small></div></div>
                <div class="col"><p>Quote sent</p><div class="tkt">Geyser or stove wiring<small>Gatesville</small></div><div class="tkt">Outside lighting<small>Bridgetown</small></div></div>
                <div class="col"><p>Won</p><div class="tkt g">COC<small>Review asked</small></div></div>
              </div>
            </div>
          </div>
          <div>
            <p class="eyebrow">Enquiry tracking</p>
            <h3>Every quote request in one place, from first message to won job.</h3>
            <ul>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Smart quote form: job type, suburb, photos</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Instant alert to you, instant reply to the customer</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>A monthly report: enquiries, top jobs, won and lost</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Your customers' details stay yours, under a written POPIA agreement</li>
            </ul>
            <div class="svc-price"><strong>{R(m.leads.price)}</strong><span class="muted">a month</span><a href="#demo">Try the demo</a></div>
          </div>
        </div>

        <div class="svc">
          <div class="svc-art" style="--c:#e7efdc" aria-hidden="true">
            <div class="card-ui gbp">
              <div class="map"><span class="pin"></span></div>
              <div class="gbp-b">
                <strong>Ndlovu Electrical</strong>
                <span class="muted">Electrician in Athlone</span>
                <p class="hours"><b>Open</b> &middot; Closes 5pm</p>
                <div class="gbp-acts"><span>Call</span><span>Directions</span><span>Website</span></div>
              </div>
            </div>
          </div>
          <div>
            <p class="eyebrow">Google Business Profile</p>
            <h3>Show up on Google Maps with the right hours, photos and areas.</h3>
            <ul>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>Profile created or cleaned up, linked to your website</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>In your name. We are added as a manager, and you can remove us any time</li>
            </ul>
            <div class="svc-price"><strong>{R(x.googleBusinessProfile.price)}</strong><span class="muted">or included in Business</span></div>
          </div>
        </div>

        <div class="svc flip">
          <div class="svc-art" style="--c:var(--sign-soft)" aria-hidden="true">
            <div class="card-ui chat">
              <div class="chat-h">Fazila's Kitchen<small>Business account</small></div>
              <div class="chat-b">
                <div class="bub me">Hi, do you have milk tart this weekend?</div>
                <div class="bub">Hi! Thanks for messaging Fazila's Kitchen. Order by Thursday for the weekend. Here is our menu:</div>
                <div class="quick"><span>Menu</span><span>Prices</span><span>Delivery areas</span></div>
              </div>
            </div>
          </div>
          <div>
            <p class="eyebrow">WhatsApp, logo and posters</p>
            <h3>The small things customers notice first.</h3>
            <ul>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>WhatsApp Business: catalogue, greeting and away messages, quick replies ({R(x.whatsappSetup.price)})</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>A clean name logo, 3 options ({R(x.logo.price)})</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m5 12 4.5 4.5L19 7"/></svg>3 posters sized for Facebook and Instagram ({R(x.posters.price)})</li>
            </ul>
            <div class="svc-price"><span class="muted">All three in the Launch Pack,</span><strong>{R(w.launchPack.price)}</strong></div>
          </div>
        </div>
      </div>
    </section>

    <!-- DEMO -->
    <section class="sec sand" id="demo" aria-labelledby="demo-h">
      <div class="wrap">
        <div class="head center">
          <p class="eyebrow">Live demo, made-up data</p>
          <h2 id="demo-h">Be the customer. Watch what the owner sees.</h2>
          <p class="lead">Pick a job and an area on the left, then send it. This is Straat Leads at {R(m.leads.price)} a month.</p>
        </div>
        <div class="demo-grid">
          <form class="panel" id="demo-form">
            <div class="panel-h"><strong>Get a quote</strong><span class="who">Customer</span></div>
            <fieldset><legend>What do you need?</legend>
              <div class="opts">
                {['DB board upgrade', 'COC certificate', 'Fault finding'].map((j, i) => (
                  <label class="opt"><input type="radio" name="job" value={j} checked={i === 0} /><span>{j}</span></label>
                ))}
              </div>
            </fieldset>
            <fieldset><legend>Where?</legend>
              <div class="opts">
                {['Athlone', 'Rylands', 'Gatesville', 'Bridgetown'].map((a, i) => (
                  <label class="opt"><input type="radio" name="area" value={a} checked={i === 0} /><span>{a}</span></label>
                ))}
              </div>
            </fieldset>
            <p class="demo-note">Problem: "Lights trip when the geyser switches on." 2 photos added.</p>
            <div class="demo-acts"><button class="btn btn-blue" type="submit">Send quote request</button></div>
            <p class="demo-note" id="demo-thanks" aria-live="polite"></p>
          </form>
          <div class="panel" aria-live="polite">
            <div class="panel-h"><strong>StraatOS enquiries</strong><span class="who">Owner</span></div>
            <div id="inbox">
              <div class="inbox-row"><div><b>Geyser or stove wiring</b><small>Rylands, 2 days ago</small></div><span class="status s-quote">Quote sent</span></div>
              <div class="inbox-row"><div><b>COC certificate</b><small>Gatesville, 5 days ago</small></div><span class="status s-won">Won</span></div>
            </div>
            <div class="alert" id="demo-alert" hidden><i></i><span id="demo-alert-t"></span></div>
            <div class="demo-acts" id="demo-acts" hidden>
              <button class="btn btn-ghost btn-sm" type="button" id="demo-next">Move to next step</button>
              <button class="btn btn-ghost btn-sm" type="button" id="demo-reset">Start again</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICES -->
    <section class="sec" id="prices" aria-labelledby="prices-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Prices</p>
          <h2 id="prices-h">Prices on the page, not after a meeting.</h2>
          <p class="lead">Once-off and final. Every package includes a .co.za domain, first-year hosting, the words written for you and 2 rounds of changes.</p>
        </div>
        <div class="price-grid">
          <article class="pcard">
            <h3>{w.onePage.name}</h3>
            <p class="for">For new businesses and sellers who need one link that explains everything.</p>
            <p class="amt">{R(w.onePage.price)}</p><p class="when">Live in 3 working days</p>
            <ul>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="m5 12 4.5 4.5L19 7"/></svg>Services, prices, hours, map</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="m5 12 4.5 4.5L19 7"/></svg>Call, WhatsApp and enquiry form</li>
              <li><svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="m5 12 4.5 4.5L19 7"/></svg>info@ email to your Gmail</li>
            </ul>
            <a class="btn btn-ghost" href={whatsappHref(`Hi Straat Studio, I'm interested in the ${w.onePage.name} website.`)} rel="noopener">Start with One-Page</a>
          </article>
          <article class="pcard hi">
            <span class="tag">Recommended for trades</span>
            <h3>{w.business.name}</h3>
