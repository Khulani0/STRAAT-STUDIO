                  <div class="dev-bar" aria-hidden="true"><i></i><i></i><i></i></div>
                  <img
                    src={`/work/${c.key}-desktop-600.webp`}
                    srcset={`/work/${c.key}-desktop-600.webp 600w, /work/${c.key}-desktop-800.webp 800w, /work/${c.key}-desktop-1200.webp 1200w`}
