  <script is:inline define:vars={{ waBase: `https://wa.me/${business.phoneDigits}?text=` }}>
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const rand = (n) => 'R' + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

    // Package builder
    const calc = () => {
      const site = $('input[name="b-site"]:checked');
      const plan = $('input[name="b-plan"]:checked');
      const isLaunch = site.dataset.name === 'Launch Pack';
      const extras = $$('input[name="b-extra"]');
      extras.forEach((e) => { e.disabled = isLaunch; if (isLaunch) e.checked = false; e.closest('.opt').style.opacity = isLaunch ? .45 : 1; });
      const chosen = extras.filter((e) => e.checked);
      const once = Number(site.value) + chosen.reduce((s, e) => s + Number(e.value), 0);
      const monthly = Number(plan.value);
      $('#b-once').textContent = rand(once);
      $('#b-month').textContent = monthly ? `${rand(monthly)} a month` : 'Nothing monthly';
      const msg = `Hi Straat Studio, I'd like: ${site.dataset.name}${chosen.length ? ' + ' + chosen.map((e) => e.dataset.name).join(', ') : ''}${monthly ? ' + ' + plan.dataset.name : ''}. Total ${rand(once)} once-off${monthly ? ', then ' + rand(monthly) + ' a month' : ''}.`;
      $('#b-send').href = waBase + encodeURIComponent(msg);
    };
    $$('#builder input').forEach((i) => i.addEventListener('change', calc));
    calc();

    // Enquiry demo
    const steps = [['New', 's-new'], ['Quote sent', 's-quote'], ['Won', 's-won']];
    let stage = 0, row = null;
    $('#demo-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const job = $('input[name="job"]:checked').value, area = $('input[name="area"]:checked').value;
      if (row) row.remove();
      stage = 0;
      row = document.createElement('div');
      row.className = 'inbox-row new';
      row.innerHTML = `<div><b></b><small></small></div><span class="status s-new">New</span>`;
      row.querySelector('b').textContent = job;
      row.querySelector('small').textContent = `${area}, just now, 2 photos`;
      $('#inbox').prepend(row);
      $('#demo-alert').hidden = false;
      $('#demo-alert-t').textContent = `New enquiry: ${job}, ${area}. Sent to your phone.`;
      $('#demo-acts').hidden = false;
      $('#demo-next').textContent = 'Move to next step';
      $('#demo-thanks').textContent = `Thanks, your request is in. Ndlovu Electrical will reply soon. A copy is in your email.`;
    });
    $('#demo-next').addEventListener('click', () => {
      if (!row) return;
      stage = Math.min(stage + 1, 2);
      const s = row.querySelector('.status');
      s.className = 'status ' + steps[stage][1];
      s.textContent = steps[stage][0];
      if (stage === 2) { $('#demo-alert-t').textContent = 'Job won. One tap sends the customer your Google review link.'; $('#demo-next').textContent = 'Done'; }
      else $('#demo-alert-t').textContent = 'Quote sent. Every step is tracked, so no job gets forgotten.';
    });
    $('#demo-reset').addEventListener('click', () => {
      if (row) row.remove(); row = null; stage = 0;
      $('#demo-alert').hidden = true; $('#demo-acts').hidden = true; $('#demo-thanks').textContent = '';
    });
  </script>
</BaseLayout>

<style is:global>

    /* Hero */
    .hero { padding: 56px 0 72px; overflow: hidden; }
    @media (min-width: 1024px) { .hero { padding: 88px 0 104px; } }
    .hero-grid { display: grid; gap: 56px; align-items: center; }
    @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.05fr 1fr; gap: 40px; } }
    .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
    .hero-trust { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 10px; font-size: 16px; }
    @media (min-width: 640px) { .hero-trust { display: flex; flex-wrap: wrap; gap: 10px 26px; } }
    .hero-trust li { display: flex; gap: 8px; align-items: center; white-space: nowrap; }

    .stage { position: relative; aspect-ratio: 1 / 0.92; max-width: 600px; width: 100%; margin: 0 auto; }
    .stage-disc { position: absolute; inset: 6% 4% 4% 10%; border-radius: 50%; background: var(--blue-soft); }
    .stage-disc::after { content: ''; position: absolute; width: 22%; aspect-ratio: 1; border-radius: 50%; background: var(--sign); right: 2%; top: 4%; }
    .browser { position: absolute; left: 0; top: 8%; width: 80%; background: #fff; border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(15,27,45,.35); overflow: hidden; font-size: 12px; }
    .browser-bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: var(--sand); border-bottom: 1px solid var(--line); }
    .phone-demo { background: var(--sign-soft); color: var(--ink); font-size: 9.5px; font-weight: 700; text-align: center; padding: 3px 6px; }
    .browser-bar i { width: 9px; height: 9px; border-radius: 50%; background: #d6d2c8; }
    .phone { position: absolute; right: 0; bottom: 0; width: 35%; aspect-ratio: 9 / 18.5; background: var(--ink); border-radius: 28px; padding: 9px; box-shadow: 0 30px 60px -24px rgba(15,27,45,.45); }
    .phone-screen { width: 100%; height: 100%; border-radius: 20px; background: #eef1f5; overflow: hidden; display: flex; flex-direction: column; font-size: 11px; }
    .phone-top { background: var(--night); color: #fff; padding: 14px 12px 10px; font-weight: 600; font-size: 11.5px; }
    .phone-top small { display: block; font-weight: 400; color: var(--on-night); font-size: 10px; }
    .notif { margin: 10px; background: #fff; border-radius: 12px; padding: 10px; box-shadow: 0 6px 16px -8px rgba(0,0,0,.25); }
    .notif-h { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); }
    .notif-h i { width: 14px; height: 14px; border-radius: 4px; background: var(--blue); }
    .notif b { display: block; margin-top: 4px; font-size: 11.5px; }
    .chip { display: inline-block; font-size: 9.5px; font-weight: 700; padding: 3px 7px; border-radius: 999px; background: var(--sign-soft); color: #6b4e00; margin-top: 6px; }
    .chip.blue { background: var(--blue-soft); color: var(--blue-dark); }
    .chip.green { background: #dcf7e6; color: #0b6b35; }
    .row-mini { margin: 0 10px 8px; background: #fff; border-radius: 10px; padding: 8px 10px; display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .row-mini span { font-size: 10px; line-height: 1.3; }
    .stage-cap { position: absolute; left: 0; bottom: -34px; }
    @media (max-width: 639px) {
      .stage { aspect-ratio: 1 / 1.18; }
      .browser { width: 92%; top: 0; }
        .phone { width: 52%; }
      .stage-disc { inset: 18% 0 6% 10%; }
      .stage-cap { bottom: -30px; }
      .stage { margin-bottom: 0; }
    }
    .phone-sum { margin: auto 10px 12px; background: var(--sign-soft); border-radius: 10px; padding: 10px; font-size: 10.5px; line-height: 1.5; }
    .phone-sum b { font-size: 13px; }
    .th-map { margin: 6px 14px 14px; border-radius: 10px; overflow: hidden; border: 1px solid #eadde4; }
    .th-map div { display:none; height: 70px; background: linear-gradient(90deg, transparent 46%, #fff 46%, #fff 52%, transparent 52%), linear-gradient(0deg, transparent 44%, #fff 44%, #fff 50%, transparent 50%), #efe4ea; }
    .th-map p { padding: 8px 10px; font-size: 10px; background: #fff; }

    /* Trades */
    .trades { background: var(--sand); padding: 56px 0; }
    .trades-title { text-align: center; font: 500 17px/1.5 var(--sans); color: var(--muted); margin-bottom: 28px; }
    .trade-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    @media (min-width: 720px) { .trade-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
    .trade { background: #fff; border-radius: 12px; padding: 18px; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 15.5px; line-height: 1.3; box-shadow: 0 1px 0 var(--line); }
    .trade svg { width: 26px; height: 26px; flex: none; stroke: var(--ink); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

