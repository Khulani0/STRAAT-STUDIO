---
import { business, paiaPublished, phoneHref, emailHref, whatsappHref } from '../config/business';
export interface Props { waMessage: string }
const { waMessage } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a href="/" class="logo" aria-label="Straat Studio, home"><img src="/brand/logo-light.svg" width="263" height="40" alt="Straat Studio" loading="lazy" /></a>
        <p style="margin-top:16px;max-width:36ch">Websites and enquiry alerts for small businesses across South Africa. Final prices. You own your domain.</p>
      </div>
      <div><h2 class="foot-h">Contact</h2><ul>
        <li><a href={whatsappHref(waMessage)} rel="noopener">WhatsApp us</a></li>
        <li><a href={phoneHref} data-event="phone-click">Call {business.phoneDisplay}</a></li>
        <li><Fragment set:html="<!--email_off-->" /><span class="plain-email">{business.email}</span><Fragment set:html="<!--/email_off-->" /> <a href={emailHref} aria-label="Open your mail app to email us">(open mail app)</a></li>
        <li><span>Based in Cape Town. Serving all of South Africa.</span></li>
      </ul></div>
      <div><h2 class="foot-h">Websites for</h2><ul>
        <li><a href="/websites-for-electricians/">Electricians</a></li>
        <li><a href="/websites-for-plumbers/">Plumbers</a></li>
        <li><a href="/websites-for-salons/">Salons</a></li>
        <li><a href="/websites-for-home-bakers/">Home bakers</a></li>
      </ul></div>
      <div><h2 class="foot-h">Explore</h2><ul>
        <li><a href="/websites/">Websites</a></li>
        <li><a href="/enquiry-system/">Enquiry alerts</a></li>
        <li><a href="/prices/">Prices</a></li>
        <li><a href="/examples/">Examples</a></li>
        <li><a href="/how-it-works/">How it works</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul></div>
    </div>
    <div class="foot-legal">
      <p>{business.legalName}, Reg. {business.regNumber}</p>
      <p>{business.name} is a trading name of {business.legalName}. &copy; {year}.</p>
      <p><a href="/privacy/">Privacy notice</a> &middot; <a href="/terms/">Terms of service</a>{paiaPublished && <> &middot; <a href="/paia-manual/">PAIA manual</a></>}</p>
    </div>
  </div>
</footer>
