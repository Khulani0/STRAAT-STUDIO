---
import { formatRand as R } from '../config/business';
export interface Props { slug: string; img: string; name: string; line: string; pkgName: string; price: number; desktopAlt: string; level?: 'h2' | 'h3' }
const { slug, img, name, line, pkgName, price, desktopAlt, level = 'h3' } = Astro.props;
const H = level;
const src = (w: number) => `/work/${img}-desktop-${w}.webp`;
---
<article class="ex-tile" data-reveal>
  <a class="ex-shot" href={`/examples/${slug}/`} tabindex="-1" aria-hidden="true">
    <img src={src(800)} srcset={`${src(800)} 800w, ${src(1200)} 1200w, ${src(1600)} 1600w`} sizes="(min-width: 1160px) 360px, (min-width: 640px) 33vw, 92vw" width="1600" height="1000" alt="" loading="lazy" decoding="async" />
  </a>
  <div class="ex-body">
    <span class="pill">{pkgName} package, {R(price)}</span>
    <H>{name}</H>
    <p>{line}</p>
    <p class="ex-label">Concept project, not commissioned client work</p>
    <a class="btn btn-secondary" href={`/examples/${slug}/`}>See this example<span class="sr"> of {name}</span></a>
  </div>
</article>
