---
import LaptopMock from './LaptopMock.astro';
import { formatRand as R } from '../config/business';
export interface Props { slug: 'fazila' | 'thandeka' | 'ndlovu'; name: string; blurb: string; pkgName: string; price: number; desktopAlt: string; phoneAlt: string; level?: 'h2' | 'h3' }
const { slug, name, blurb, pkgName, price, desktopAlt, phoneAlt, level = 'h3' } = Astro.props;
const H = level;
---
<article class="tile" data-reveal>
  <p class="concept-note">Concept project, not commissioned client work</p>
  <H>{name}</H>
  <p>{blurb}</p>
  <span class="pill">{pkgName} package, {R(price)}</span>
  <div class="tile-devs">
    {slug === 'thandeka' ? (
      <LaptopMock alt={desktopAlt}>
        <div class="msc"><div class="ms" aria-hidden="true">
          <div class="ms-nav"><b>Thandeka Hair Studio</b><span>Prices</span><span>Hours</span><span>Find us</span></div>
          <div class="ms-hero"><h4>Braids and natural hair, done with care.</h4><div class="sub">Open Tuesday to Saturday. Book by WhatsApp.</div><span class="ob">Book on WhatsApp</span></div>
          <div class="ms-list"><div><span>Knotless braids</span><b>from R550</b></div><div><span>Cornrows</span><b>from R180</b></div><div><span>Twists</span><b>from R450</b></div><div><span>Wash and style</span><b>from R150</b></div></div>
          <div class="ms-foot">Tue to Sat, 09:00 to 17:00 · Sample content</div>
        </div></div>
      </LaptopMock>
    ) : slug === 'fazila' ? (
      <LaptopMock alt={desktopAlt}>
        <div class="msc"><div class="ms" aria-hidden="true">
          <div class="ms-nav"><b>Fazila's Kitchen</b><span>Cakes</span><span>Savouries</span><span>How to order</span></div>
          <div class="ms-hero"><h4>Home baking, made to order.</h4><div class="sub">Order three days ahead. Collect or we deliver nearby.</div></div>
          <div class="ms-cards">
            <div class="ms-card"><i class="sw s1"></i><b>Chocolate ring cake</b><span>R280</span><span class="ob">Order on WhatsApp</span></div>
            <div class="ms-card"><i class="sw s2"></i><b>Samoosa platter</b><span>R240</span><span class="ob">Order on WhatsApp</span></div>
            <div class="ms-card"><i class="sw s3"></i><b>Vanilla cupcakes</b><span>R150</span><span class="ob">Order on WhatsApp</span></div>
          </div>
        </div></div>
      </LaptopMock>
    ) : (
      <LaptopMock src={`/work/${slug}-desktop-400.webp`} srcset={`/work/${slug}-desktop-400.webp 400w, /work/${slug}-desktop-600.webp 600w, /work/${slug}-desktop-800.webp 800w, /work/${slug}-desktop-1200.webp 1200w`} sizes="(min-width: 960px) 300px, 90vw" alt={desktopAlt} />
    )}
    <div class="phone" role="img" aria-label={phoneAlt}>
      <div class="phone-frame"><div class="phone-screen">
        {slug === 'thandeka' ? (
          <div class="mp" aria-hidden="true"><div class="mp-top">Thandeka Hair Studio</div><h4>Braids and natural hair, done with care.</h4><div class="mp-row"><span>Knotless braids</span><b>from R550</b></div><div class="mp-row"><span>Cornrows</span><b>from R180</b></div><div class="mp-row"><span>Twists</span><b>from R450</b></div><span class="ob">Book on WhatsApp</span></div>
        ) : slug === 'fazila' ? (
          <div class="mp" aria-hidden="true"><div class="mp-top">Fazila's Kitchen</div><h4>Home baking, made to order.</h4><div class="mp-card"><i class="sw s1"></i><b>Chocolate ring cake</b><span>R280</span></div><span class="ob">Order on WhatsApp</span><div class="mp-card"><i class="sw s2"></i><b>Samoosa platter</b><span>R240</span></div><span class="ob">Order on WhatsApp</span></div>
        ) : (
          <img src={`/work/${slug}-phone-200.webp`} srcset={`/work/${slug}-phone-200.webp 200w, /work/${slug}-phone-390.webp 390w, /work/${slug}-phone-780.webp 780w`} sizes="100px" width="780" height="1688" alt="" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:top" />
        )}
      </div></div>
    </div>
  </div>
</article>
