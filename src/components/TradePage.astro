---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import DarkBand from './DarkBand.astro';
import Accordion from './Accordion.astro';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
import PhoneMock from './PhoneMock.astro';
import { business, prices, maxPages, formatRand as R, whatsappHref, deliveryLine } from '../config/business';

export interface Props {
  title: string;
  description: string;
  path: string;
  crumb: string;
  eyebrow: string;
  h1: string;
  lead: string;
  waMessage: string;
  ctaLabel: string;
  cta: { heading: string; text: string };
  searches: { heading: string; intro: string; items: string[]; outro: string };
  sitePages: { heading: string; intro: string; items: { name: string; text: string }[]; outro?: string };
  does: { heading: string; intro: string; items: { name: string; text: string }[] };
  pkg: { key: keyof typeof prices.websites; heading: string; paragraphs: string[]; live: number; soon?: boolean };
  faqs: [string, string][];
}

const p = Astro.props;
const pk = prices.websites[p.pkg.key];
const pages = maxPages[p.pkg.key];
const wa = whatsappHref(p.waMessage);
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: p.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
const pageIcons = ['browser', 'quote', 'search', 'pin', 'camera', 'layers'] as const;
const doIcons = ['phone', 'whatsapp', 'quote'] as const;
const pkgTitles = ['The package that fits', 'If you need something different', 'How you pay', 'After launch'] as const;
const pkgIcons = ['tag', 'layers', 'coin', 'shield'] as const;
---

<BaseLayout
  title={p.title}
  description={p.description}
  path={p.path}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: p.crumb, path: p.path }]}
  jsonLd={jsonLd}
  whatsappMessage={p.waMessage}
>
  <PageHero label={p.eyebrow} h1={p.h1} lead={p.lead}>
    <Fragment slot="actions">
      <Button href={wa} event="whatsapp-click">{p.ctaLabel}</Button>
      <Button href="/prices/" variant="secondary">See all prices</Button>
    </Fragment>
    <div slot="visual" style="max-width:300px;margin:0 auto;width:100%">
      <PhoneMock float />
      <p class="concept-note" style="margin-top:12px;text-align:center">Example with made-up data. Concept project, not commissioned client work.</p>
    </div>
  </PageHero>

  <section class="section bg-grey" aria-labelledby="s-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>Searches</SectionLabel>
        <h2 id="s-h">{p.searches.heading}</h2>
        <p class="lead">{p.searches.intro}</p>
      </div>
      <ul class="chips" data-reveal>{p.searches.items.map((i) => <li><Icon name="search" />{i}</li>)}</ul>
      <p class="small muted" style="margin-top:20px;max-width:720px">{p.searches.outro}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="pg-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>Pages</SectionLabel>
        <h2 id="pg-h">{p.sitePages.heading}</h2>
        <p class="lead">{p.sitePages.intro}</p>
      </div>
      <div class="grid g3">
        {p.sitePages.items.map((i, n) => <Card icon={pageIcons[n % pageIcons.length]} title={i.name}><p>{i.text}</p></Card>)}
      </div>
      {p.sitePages.outro && <p class="small muted" style="margin-top:24px;max-width:720px">{p.sitePages.outro}</p>}
      <slot />
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="do-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>What the site does</SectionLabel>
        <h2 id="do-h">{p.does.heading}</h2>
        <p class="lead">{p.does.intro}</p>
      </div>
      <div class="grid g3">
        {p.does.items.map((i, n) => <Card icon={doIcons[n % doIcons.length]} title={i.name}><p>{i.text}</p></Card>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pk-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <SectionLabel>Price</SectionLabel>
        {p.pkg.soon && <p><span class="pill soon">Coming soon</span></p>}
        <h2 id="pk-h">{p.pkg.heading}</h2>
        <p class="lead">{R(pk.price)}, once-off and final, no VAT added. {pages === 1 ? '1 page' : `Up to ${pages} pages`}. {deliveryLine(p.pkg.live)}.</p>
      </div>
      <div class="grid g2">
        {p.pkg.paragraphs.map((t, n) => <Card icon={pkgIcons[n % pkgIcons.length]} title={pkgTitles[n % pkgTitles.length]}><p>{t}</p></Card>)}
      </div>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="head" data-reveal><SectionLabel>Questions</SectionLabel><h2 id="faq-h">Questions we get from this trade</h2></div>
      <Accordion items={p.faqs} />
      <ul class="links"><li><a href="/prices/">See all prices</a></li><li><a href="/contact/">Contact page</a></li></ul>
    </div>
  </section>

  <DarkBand heading={p.cta.heading} text={p.cta.text} waMessage={p.waMessage} waLabel={p.pkg.soon ? p.ctaLabel : `${p.ctaLabel} on WhatsApp`} />
</BaseLayout>
