---
import '../styles/global.css';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import { defaultWhatsappMessage } from '../config/business';

export interface Props extends SEOProps {
  /** Pre-filled WhatsApp message for this page. */
  whatsappMessage?: string;
  /** Shows a "Last updated" line under the header (legal pages), for example "18 November 2026". */
  lastUpdated?: string;
}
const { whatsappMessage = defaultWhatsappMessage, lastUpdated, ...seo } = Astro.props;
---
<!doctype html>
<html lang="en-ZA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <SEO
    {...seo}
    image={seo.image ?? '/og/straat-studio-share.jpg'}
    imageAlt={seo.imageAlt ?? 'Straat Studio: websites and enquiry systems for South African businesses.'}
  />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader waMessage={whatsappMessage} />
  <main id="main">
    {lastUpdated && <p class="updated">Last updated: {lastUpdated}</p>}
    <slot />
  </main>
  <SiteFooter waMessage={whatsappMessage} />
  <StickyMobileBar waMessage={whatsappMessage} />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
