---
import '../styles/global.css';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import {
  business,
  phoneHref,
  emailHref,
  whatsappHref,
  defaultWhatsappMessage,
} from '../config/business';

export interface Props extends SEOProps {
  /** Pre-filled WhatsApp message for this page. */
  whatsappMessage?: string;
  /** Shows the "Draft, review before launch" banner (legal pages). */
  draft?: boolean;
}

const { whatsappMessage = defaultWhatsappMessage, draft = false, ...seo } = Astro.props;
const wa = whatsappHref(whatsappMessage);
const year = new Date().getFullYear();

// In-page anchors that exist on the homepage. Root-relative so they work from any page.
const nav = [
  { label: 'Prices', href: '/#prices' },
  { label: 'See it work', href: '/#demo' },
  { label: 'Build your package', href: '/#builder' },
  { label: 'Sample work', href: '/#work' },
  { label: 'How it works', href: '/#process' },
  { label: 'Questions', href: '/#questions' },
];
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO {...seo} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-ink">
    <a class="skip-link" href="#main">Skip to content</a>

    {draft && <p class="bg-mist text-ink text-center text-sm py-2 px-6 border-b border-line">Draft, review before launch</p>}

    <header class="bg-white border-b border-line sticky top-0 z-30">
      <div class="container-site flex items-center justify-between gap-4 py-3">
        <a href="/" class="font-bold text-xl tracking-tight no-underline text-ink">Straat Studio</a>

        <nav aria-label="Main" class="hidden lg:flex items-center gap-6 text-base">
          {nav.slice(0, 5).map((n) => <a href={n.href} class="text-ink no-underline hover:text-accent">{n.label}</a>)}
        </nav>

        <div class="flex items-center gap-3">
          <a class="btn btn-whatsapp hidden sm:inline-flex" href={wa} data-event="whatsapp-click" rel="noopener">WhatsApp us</a>
          <button
            type="button"
            id="menu-button"
            class="lg:hidden btn btn-outline"
            aria-expanded="false"
            aria-controls="menu-panel"
          >Menu</button>
        </div>
      </div>

      <nav id="menu-panel" aria-label="Mobile" hidden class="lg:hidden border-t border-line bg-white">
        <ul class="container-site py-2">
          {nav.map((n) => (
            <li><a href={n.href} class="block py-3 text-ink no-underline border-b border-mist">{n.label}</a></li>
          ))}
          <li><a href="/#contact" class="block py-3 text-accent font-bold no-underline">Get a free preview</a></li>
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="bg-black text-muted-dark on-black pb-24 sm:pb-0">
      <div class="container-site py-12 grid gap-10 md:grid-cols-3 text-base" id="site-footer">
        <div>
          <p class="font-bold text-white text-xl">{business.name}</p>
          <p class="mt-3">Websites for small businesses across South Africa. Final prices. You own your domain. Based in Cape Town.</p>
        </div>
        <div>
          <p class="font-bold text-white">Contact</p>
          <ul class="mt-3 grid gap-2">
            <li><a class="text-accent-light underline" href={wa} data-event="whatsapp-click" rel="noopener">WhatsApp us</a></li>
            <li><a class="text-accent-light underline" href={phoneHref} data-event="phone-click">Call {business.phoneDisplay}</a></li>
            <li><a class="text-accent-light underline" href={emailHref}>{business.email}</a></li>
            <li>Cape Town, South Africa</li>
          </ul>
        </div>
        <div>
          <p class="font-bold text-white">Company</p>
          <ul class="mt-3 grid gap-2">
            <li><a class="text-accent-light underline" href="/#process">How it works</a></li>
            <li><a class="text-accent-light underline" href="/#prices">Prices</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/15">
        <div class="container-site py-6 text-xs leading-relaxed">
          <p>{business.legalName}, Reg. {business.regNumber}</p>
          <p class="mt-1">{business.name} is a trading name of {business.legalName}. &copy; {year}. Based in Cape Town.</p>
        </div>
      </div>
    </footer>

    <!-- Floating WhatsApp button, mobile only. Hidden by script when the contact section or footer is on screen. -->
    <a
      id="wa-float"
      href={wa}
      data-event="whatsapp-click"
      rel="noopener"
      class="btn btn-whatsapp fixed bottom-4 right-4 z-40 sm:hidden"
      aria-label="Chat on WhatsApp"
    >WhatsApp</a>
  </body>
</html>

<script>
  import '../scripts/site.js';
</script>
